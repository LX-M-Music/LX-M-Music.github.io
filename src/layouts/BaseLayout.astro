---
/// 站点骨架：主题预载 + SplashScreen + 顶栏 + 抽屉 + 页脚
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  active?: '/' | '/docs' | '/download';
  /** 页面主体是否使用带侧栏的宽布局 */
  wide?: boolean;
}

const {
  title = 'LX-M Music - 扩展音源 · Cookie同步 · 高音质',
  description = 'LX-M Music 桌面版官网 - 免费开源的音乐播放器：扩展音源插件、五平台 Cookie 同步、歌曲换源、七档音质解锁',
  keywords = 'LX-M, LX-M Music, lx-music, 洛雪音乐, 扩展音源, Cookie同步, 歌曲换源, 高音质',
  active,
} = Astro.props;

const appRepoUrl = 'https://github.com/LX-M-Music/lx-m_lx-Miao-moe-music-desktop';
const siteRepoUrl = 'https://github.com/LX-M-Music/LX-M-Music.github.io';

/// 随机加载吉祥物：仓鼠原图 + 三张生成动图
const mascots = ['/loading/hamster.png', '/loading/gif-bounce.gif', '/loading/gif-wiggle.gif', '/loading/gif-peek.gif'];
const mascot = mascots[Math.floor(Math.random() * mascots.length)];
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f8fa" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/Icon-192.png" />
    <title>{title}</title>

    <script is:inline>
      // 主题预载：避免 FOUC（必须在首帧前执行）
      (function () {
        try {
          var saved = localStorage.getItem('lxm-theme');
          var theme = saved === 'light' || saved === 'dark'
            ? saved
            : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <style is:inline>
      /* 内联 SplashScreen：主题预载后立即可见，不依赖外部 CSS */
      #lxm-splash {
        position: fixed;
        inset: 0;
        z-index: 999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        background: radial-gradient(120% 90% at 80% 10%, rgba(74, 222, 128, 0.14) 0%, transparent 55%),
          linear-gradient(160deg, #0b1220 0%, #101a2b 55%, #0b1220 100%);
        color: #4ade80;
        font-family: 'PingFang SC', 'HarmonyOS Sans SC', 'Microsoft YaHei UI', 'Microsoft YaHei', system-ui, sans-serif;
        transition: opacity 0.38s ease;
      }
      #lxm-splash.splash-done {
        opacity: 0;
        pointer-events: none;
      }
      #lxm-splash .mascot {
        width: 132px;
        height: 132px;
        object-fit: contain;
        animation: mascot-bob 1.6s ease-in-out infinite;
      }
      #lxm-splash .wordmark {
        font-weight: 800;
        letter-spacing: 0.14em;
        font-size: 0.95rem;
      }
      #lxm-splash .hint {
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        color: rgba(148, 163, 184, 0.75);
      }
      #lxm-splash .bar {
        width: 148px;
        height: 3px;
        border-radius: 99px;
        background: rgba(255, 255, 255, 0.1);
        overflow: hidden;
      }
      #lxm-splash .bar i {
        display: block;
        height: 100%;
        width: 40%;
        border-radius: 99px;
        background: #4ade80;
        animation: bar-slide 1.1s ease-in-out infinite;
      }
      @keyframes mascot-bob {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-9px) rotate(-3deg); }
      }
      @keyframes bar-slide {
        0% { transform: translateX(-110%); }
        100% { transform: translateX(380%); }
      }
    </style>
  </head>
  <body>
    <!-- SplashScreen：每会话首次访问展示，之后极速隐去 -->
    <div id="lxm-splash" aria-hidden="true">
      <img class="mascot" src={mascot} alt="" width="132" height="132" />
      <div class="wordmark">LX-M MUSIC</div>
      <div class="hint">加载中…请稍候喵</div>
      <div class="bar"><i></i></div>
    </div>

    <header class="site-bar">
      <div class="site-bar-inner">
        <a class="brand-link" href="/">
          <img src="/icons/Icon-192.png" alt="LX-M Music 图标" width="30" height="30" />
          <b>LX-M</b>
        </a>
        <nav class="nav-links" aria-label="主导航">
          <a href="/" class={active === '/' ? 'active' : ''}>首页</a>
          <a href="/docs" class={active === '/docs' ? 'active' : ''}>文档</a>
          <a href="/download" class={active === '/download' ? 'active' : ''}>下载</a>
        </nav>
        <button class="icon-btn theme-btn" id="theme-toggle" type="button" aria-label="切换亮暗主题" title="切换亮暗主题">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="icon-btn" href={appRepoUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub 仓库" title="GitHub 仓库">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.05 11.05 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
        </a>
        <button class="icon-btn menu-btn" id="drawer-open" type="button" aria-label="打开菜单">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </header>

    <div class="drawer-mask" id="drawer-mask"></div>
    <aside class="site-drawer" id="site-drawer" aria-label="移动端菜单">
      <div class="fox-panel">
        <img src={`https://t.alcy.cc/xhl?t=${Date.now()}`} alt="随机萌图" loading="lazy" />
        <div class="overlay"></div>
        <div class="panel-text">
          <b>LX-M Music</b>
          <span>免费开源的音乐播放器</span>
        </div>
      </div>
      <nav class="drawer-nav" aria-label="移动端导航">
        <a href="/" class={active === '/' ? 'active' : ''}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
          首页
        </a>
        <a href="/docs" class={active === '/docs' ? 'active' : ''}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          文档
        </a>
        <a href="/download" class={active === '/download' ? 'active' : ''}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
          下载
        </a>
        <a href={appRepoUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.05 11.05 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          GitHub
        </a>
      </nav>
      <div class="bd-banner">
        <span class="tag">每日看板</span>
        <img src={`https://t.alcy.cc/bd?t=${Date.now()}`} alt="每日看板" loading="lazy" />
      </div>
      <div class="drawer-foot">LX-M Music · 免费开源的音乐播放器</div>
    </aside>

    <main class={`site-main`}>
      <slot />
    </main>

    <footer class="site-footer">
      <p>LX-M Music · 免费开源的音乐播放器</p>
      <p>基于 LX Music (Apache License 2.0) 构建 · 站点内容 MIT · <a href={siteRepoUrl} target="_blank" rel="noopener noreferrer">站点源码</a></p>
    </footer>

    <script is:inline>
      // SplashScreen：每会话首次访问完整展示；同会话后续导航直接跳过
      (function () {
        var splash = document.getElementById('lxm-splash');
        if (!splash) return;
        var firstVisit = false;
        try {
          firstVisit = !sessionStorage.getItem('lxm-splash-seen');
          if (firstVisit) sessionStorage.setItem('lxm-splash-seen', '1');
        } catch (e) {
          firstVisit = true;
        }
        var hide = function () {
          splash.classList.add('splash-done');
          setTimeout(function () { splash.remove(); }, 450);
        };
        if (!firstVisit) {
          splash.remove();
          return;
        }
        if (document.readyState === 'complete') {
          setTimeout(hide, 250);
        } else {
          window.addEventListener('load', function () { setTimeout(hide, 250); });
          setTimeout(hide, 2200); // 兜底：网络慢也不挡用户
        }
      })();
    </script>

    <script>
      // 主题切换 + 抽屉
      function setup() {
        var root = document.documentElement;
        var toggle = document.getElementById('theme-toggle');
        toggle?.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('lxm-theme', next); } catch (e) {}
        });

        var openBtn = document.getElementById('drawer-open');
        var mask = document.getElementById('drawer-mask');
        var drawer = document.getElementById('site-drawer');
        var setDrawer = function (openState: boolean) {
          document.body.classList.toggle('drawer-open', openState);
        };
        openBtn?.addEventListener('click', function () { setDrawer(true); });
        mask?.addEventListener('click', function () { setDrawer(false); });
        drawer?.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () { setDrawer(false); });
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') setDrawer(false);
        });
      }
      setup();
    </script>
  </body>
</html>
